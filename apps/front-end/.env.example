# VenekoVox front-end configuration (client-safe values only — Vite exposes VITE_* to the browser)
# Copy to .env.local and fill in your deployment values.

# Self.xyz identity verification
# The scope ties verification results to this app; backend verifier must use the same scope.
VITE_SELF_SCOPE=venekovox-trust-ritual

# Backend endpoint that verifies Self proofs (local dev default; use your deployed URL for staging/prod)
VITE_SELF_ENDPOINT=http://localhost:3100/verify

# MACI deployment (Sepolia, Aug 2026 revival)
# ⚠️ POLL-0 IS HISTORICAL AND NOT VOTABLE: it was deployed with start/end dates
# 0/0, so its voting window never opened (verified on-chain Sep 5, 2026 via
# getStartAndEndDate). Do NOT copy this configuration into a fresh demo —
# deploy a new poll with explicit start/end dates.
VITE_MACI_ADDRESS=0x44F31f3823ceFE00C2FA5acEB2576F119143Fe3a
VITE_POLL_ID=0
VITE_CHAIN_ID=11155111

# Block where MACI was deployed — anchor for on-chain event scans (signup/join lookups).
# 0 = scan from genesis (very slow). Set this to the recorded deployment block.
VITE_MACI_START_BLOCK=11567000
