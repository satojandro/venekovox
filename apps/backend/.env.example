# Server-only. Never prefix these with VITE_ — they would be compiled into the browser.

PORT=3100

# Self.xyz
# SELF_SCOPE=venekovox-trust-ritual
# SELF_ENDPOINT=http://localhost:3100/verify
# MOCK_PASSPORT=true

# W1 Privy status reconciliation (E1). Leave unset until Alejandro enables the app.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Optional webhook shared secret for POST /w1/webhooks/privy
# W1_WEBHOOK_SECRET=
# Lab-only sponsored send (E2–E6). Never expose these to Vite.
# The allow toggle is not authorization — set operator token + probe allowlist first.
# W1_LAB_ALLOW_SPONSORED_SEND=true
# W1_LAB_OPERATOR_TOKEN=
# W1_LAB_PROBE_ADDRESS=
# W1_LAB_CHAIN_ID=11155111
# W1_LAB_WALLET_ID=
