# VenekoVox front-end configuration (client-safe values only — Vite exposes VITE_* to the browser)
# Copy to .env.local and fill in your deployment values.

# Product backend (eligibility + poll schedule). Legacy /verify is unused by Auth.
VITE_BACKEND_URL=http://localhost:3100

# Staged SelfEligibilityPolicy (WP0). Leave empty to read the Poll's extContracts.policy.
# Do not paste private keys. These must match the backend POLICY_ADDRESS/TARGET_ADDRESS.
VITE_POLICY_ADDRESS=
VITE_TARGET_ADDRESS=

# MACI deployment (Sepolia, Aug 2026 revival)
# ⚠️ POLL-0 IS HISTORICAL AND NOT VOTABLE: it was deployed with start/end dates
# 0/0, so its voting window never opened (verified on-chain Sep 5, 2026 via
# getStartAndEndDate). Do NOT copy this configuration into a fresh demo —
# deploy a new poll with explicit start/end dates.
VITE_MACI_ADDRESS=0x44F31f3823ceFE00C2FA5acEB2576F119143Fe3a
VITE_POLL_ID=0
VITE_CHAIN_ID=11155111
# Flagship metadata. Leave unset to keep France poll 1 copy for the original
# deployment. Do not set this on poll IDs 0 or 1 of the original MACI.
# VITE_POLL_PRESET=superintelligence-v1
# Optional checksum: the Poll contract address Hermes actually deployed.
# VITE_POLL_ADDRESS=
# open = judge round. rehearsal = a separately closed tally poll. Never mix.
# VITE_POLL_ROUND=open
# Isolated judge-experience preview: 3012. Live Mini stays on 3000; ENS on 3010.
# VITE_DEV_PORT=3012

# Block where MACI was deployed — anchor for on-chain event scans (signup/join lookups).
# 0 = scan from genesis (very slow). Set this to the recorded deployment block.
VITE_MACI_START_BLOCK=11567000

# Read-only public RPC on Sepolia (client-visible; no private credentials).
# Used for poll schedule reads and ENSv2 discovery. A public endpoint is enough
# for browsing; do not put private API keys here.
VITE_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_ENS_RPC_URL=

# Isolated S1.1 named-account worktree. Do not reuse the live Mini ports (3000/3100).
# VITE_DEV_PORT=3010
# VITE_BACKEND_URL=http://localhost:3110
# Named accounts (optional). Empty = naming UI stays unconfigured; voting still works.
# Alejandro chooses the parent name and deploys the registrar; do not paste keys.
VITE_ENS_REGISTRAR=
