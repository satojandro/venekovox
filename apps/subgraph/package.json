{
  "name": "@maci-protocol/subgraph",
  "version": "3.0.0",
  "description": "A subgraph to index data from MACI protocol to serve as data layer for frontend integration",
  "private": false,
  "files": [
    "build",
    "schemas",
    "config",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "precodegen": "rm -rf ./generated && pnpm generate:schema && pnpm generate:yaml",
    "codegen": "graph codegen",
    "generate:yaml": "mustache ./config/${NETWORK:-network}.json ./templates/subgraph.template.yaml > subgraph.yaml",
    "generate:schema": "cp ./schemas/schema.${VERSION:-v2}.graphql schema.graphql",
    "prebuild": "pnpm codegen",
    "build": "graph build",
    "deploy": "graph deploy venekovox-governance-v-2 --node https://api.studio.thegraph.com/deploy/ --version-label ${VERSION_LABEL:-wp4-state-leaves}",
    "create-local": "graph create --node http://localhost:8020/ venekovox-governance-v-2",
    "remove-local": "graph remove --node http://localhost:8020/ venekovox-governance-v-2",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 venekovox-governance-v-2 --network localhost",
    "create-local-shifted": "graph create --node http://localhost:18020/ venekovox-governance-v-2",
    "remove-local-shifted": "graph remove --node http://localhost:18020/ venekovox-governance-v-2",
    "deploy-local-shifted": "graph deploy --node http://localhost:18020/ --ipfs http://localhost:15001 venekovox-governance-v-2",
    "deploy:mainnet": "graph deploy --node https://api.studio.thegraph.com/deploy/ venekovox-governance-v-2 --network mainnet",
    "test": "graph test -v 0.6.0",
    "test:governance": "node --test tests/governance/*.test.mjs tests/state-leaves.test.mjs",
    "demo:governance": "node client/compare.mjs",
    "test:coverage": "graph test && graph test -c",
    "deploy:studio": "graph deploy venekovox-governance-v-2 --node https://api.studio.thegraph.com/deploy/ --version-label ${VERSION_LABEL:-wp4-state-leaves}"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "^0.97.1",
    "@graphprotocol/graph-ts": "^0.38.1",
    "@maci-protocol/contracts": "^3.0.0"
  },
  "devDependencies": {
    "assemblyscript": "0.19.23",
    "matchstick-as": "^0.6.0",
    "mustache": "^4.2.0",
    "wabt": "^1.0.37"
  }
}
