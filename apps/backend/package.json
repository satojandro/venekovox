{
  "name": "@venekovox/backend",
  "version": "0.1.0",
  "description": "VenekoVox backend - Self.xyz verification service",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node-dev src/index.ts",
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "test:polls": "node --test tests/polls.test.mjs",
    "test:p2": "node --test tests/p2/*.test.mjs",
    "typecheck:p2": "tsc -p tsconfig.p2.json --noEmit",
    "trial": "node --loader ./tests/p2/run-trial.mjs ./tests/p2/run-trial-entry.mjs"
  },
  "dependencies": {
    "@selfxyz/core": "^1.0.8",
    "@zkpassport/sdk": "0.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "ethers": "^6.15.0",
    "@selfxyz/enterprise-sdk": "0.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "svix": "^1.92.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
