# Self.xyz Configuration
# Self.xyz doesn't require a public API key - verification is handled by your backend
VITE_SELF_SCOPE=venekovox-trust-ritual

# Local backend for development
VITE_SELF_ENDPOINT=http://localhost:3100/verify

# For production, update to your deployed backend:
# VITE_SELF_ENDPOINT=https://your-production-domain.com/api/verify

# For staging/testing:
# VITE_SELF_ENDPOINT=https://staging.self.xyz/api/verify

